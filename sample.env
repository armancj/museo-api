## SERVER ENVIRONMENT
APP_PORT="5001" # The port on which the application will run
NODE_ENV="development" # development | production | test
CORS_ORIGINS="http://localhost:4000" # Comma separated origins allowed by CORS. Every origin is allowed when unset

## DB ENVIRONMENT
DB_URI="mongodb://localhost:27017/museun-bd?retryWrites=true&readPreference=primary"
# The connection string for the MongoDB database

## JWT ENVIRONMENT
JWT_SECRET="<replace-with-a-long-random-string>"   # Secret key used for signing JSON Web Tokens (JWT)
JWT_EXPIRATION_TIME="300d"  # Expiration time in m(minutes), s(seconds), d(days) for JWT tokens
JWT_REFRESH_TOKEN_SECRET="<replace-with-a-different-long-random-string>"  # Secret key used for signing refresh tokens
JWT_REFRESH_EXPIRATION_TIME="1000d"  # Expiration time in m(minutes), s(seconds), d(days) for refresh tokens

## EMAIL ENVIRONMENT
EMAIL_HOST=""  # Hostname or IP address of the SMTP server
EMAIL_PORT="465"  # Port number for the SMTP server
EMAIL_SECURE="true"  # true for port 465, false for STARTTLS ports such as 587
EMAIL_USER=""  # Username for email authentication
EMAIL_PASS=""  # Password for email authentication
EMAIL_FROM=""  # Email address for the "From" field in outgoing emails
